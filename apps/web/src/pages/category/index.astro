---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { getCollection } from "astro:content";
import { SITE } from "../../config/site.mjs";

const allIncantations = await getCollection("incantations", ({ data }) => !data.draft);

const categoryMeta: Record<string, { desc: string; color: string; icon: string }> = {
	Creational: {
		desc: "Patterns that abstract object instantiation, creating systems independent of object creation, composition, and representation.",
		color: "#38bdf8",
		icon: "✧",
	},
	Structural: {
		desc: "Patterns concerned with class and object composition, organizing larger architectures with flexible interfaces.",
		color: "#22EE44",
		icon: "◈",
	},
	Behavioral: {
		desc: "Patterns focused on algorithms, message dispatching, state machines, and delegation of responsibilities between components.",
		color: "#a855f7",
		icon: "⚡",
	},
	Architectural: {
		desc: "Higher-order system blueprints, distributed patterns, and systemic matrices governing sovereign infrastructure.",
		color: "#fbbf24",
		icon: "⬡",
	},
	Resilience: {
		desc: "Fault tolerance, self-healing wards, backpressure valves, and failover mechanisms for chaotic environments.",
		color: "#f43f5e",
		icon: "🛡️",
	},
};

const categories = ["Creational", "Structural", "Behavioral", "Architectural", "Resilience"].map((cat) => {
	const count = allIncantations.filter((spell) => spell.data.gofCategory === cat).length;
	const meta = categoryMeta[cat] || {
		desc: "Arcane software engineering patterns and code spells.",
		color: "#38bdf8",
		icon: "✧",
	};
	return {
		name: cat,
		slug: cat.toLowerCase(),
		count,
		...meta,
	};
});

const pageTitle = "Pattern Categories | Tekromancy Incantations";
const pageDesc = "Explore software design patterns categorized by Gang of Four lineage: Creational, Structural, Behavioral, Architectural, and Resilience.";
const pageUrl = `${SITE.url}/category`;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
				{ "@type": "ListItem", position: 2, name: "Categories", item: pageUrl },
			],
		},
		{
			"@type": "CollectionPage",
			name: pageTitle,
			description: pageDesc,
			url: pageUrl,
			hasPart: categories.map((c) => ({
				"@type": "WebPage",
				name: `${c.name} Incantations`,
				description: c.desc,
				url: `${SITE.url}/category/${c.slug}`,
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDesc}
	canonicalURL={pageUrl}
	jsonLd={jsonLd}
>
	<Header />
	<main class="min-h-screen bg-[#050505] text-white pt-24 pb-20 relative overflow-hidden">
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-900/15 via-[#050505] to-[#050505] pointer-events-none"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
			<!-- Semantic Breadcrumbs -->
			<nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs">
				<ol class="inline-flex items-center gap-1.5 flex-wrap text-gray-400">
					<li>
						<a href="/" class="hover:text-[#22EE44] transition-colors">Home</a>
					</li>
					<li class="opacity-40">/</li>
					<li class="font-bold text-white uppercase">Categories</li>
				</ol>
			</nav>

			<!-- Header -->
			<header class="mb-14 text-center md:text-left border-b border-white/10 pb-8">
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono mb-4 border border-[#38bdf8]/30 bg-[#38bdf8]/10 text-[#38bdf8]">
					<span>// ARCHITECTURAL LINEAGES //</span>
				</div>
				<h1 class="text-4xl md:text-6xl font-black font-mono tracking-tight text-white mb-4">
					Design Pattern Categories
				</h1>
				<p class="text-lg text-gray-400 max-w-3xl font-mono leading-relaxed">
					Software architectural spells categorized by the 1994 Gang of Four taxonomic lineage and modern resilience matrices.
				</p>
			</header>

			<!-- Category Cards Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{categories.map((cat, i) => (
					<ScrollReveal client:load delay={i * 0.08}>
						<a
							href={`/category/${cat.slug}`}
							class="group relative flex flex-col justify-between h-full rounded-2xl border border-white/10 bg-[#0a0a0a]/80 backdrop-blur p-7 transition-all duration-300 hover:border-white/30 hover:shadow-2xl hover:-translate-y-1 block"
						>
							<div class="relative z-10">
								<div class="flex items-center justify-between gap-4 mb-4">
									<span class="text-2xl" style={`color: ${cat.color};`}>{cat.icon}</span>
									<span class="px-2.5 py-1 rounded text-xs font-mono font-bold tracking-wider border border-white/10 bg-white/5 text-gray-300">
										{cat.count} {cat.count === 1 ? "Spell" : "Spells"}
									</span>
								</div>

								<h2 class="text-2xl font-bold font-mono text-white mb-3 group-hover:underline flex items-center gap-2" style={`color: ${cat.color};`}>
									<span>{cat.name}</span>
									<span class="text-xs text-gray-500 font-normal">→</span>
								</h2>

								<p class="text-sm font-mono text-gray-300 leading-relaxed mb-6">
									{cat.desc}
								</p>
							</div>

							<div class="relative z-10 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400 group-hover:text-white transition-colors">
								<span>Explore lineage</span>
								<span style={`color: ${cat.color};`}>View all {cat.count} →</span>
							</div>
						</a>
					</ScrollReveal>
				))}
			</div>

			<!-- Back Link -->
			<div class="mt-14 text-center">
				<a
					href="/"
					class="inline-flex items-center gap-2 font-mono text-sm px-6 py-3 rounded-lg border border-white/20 hover:border-[#22EE44] hover:text-[#22EE44] text-white transition-all bg-white/5"
				>
					<span>← Return to Grimoire Matrix</span>
				</a>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
