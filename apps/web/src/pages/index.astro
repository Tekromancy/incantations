const schoolsCount = new Set(allIncantations.map((i) => i.data.arcaneSchool.split("//")[0].trim())).size;
const initialSpells = allIncantations.slice(0, 24);
---

<Layout
	title={`Incantations: Shell Scripts, Programming Patterns & AI Prompts | ${SITE.title}`}
	description="Arcane shell scripts, multi-language design patterns (Python, Rust, Perl, JS), and AI prompts rooted in the Gang of Four design patterns."
	canonicalURL={`${SITE.url}/`}
>
	<Header />
	<main
		id="main-content"
		role="main"
		class="min-h-screen"
		style="background-color: var(--token-color-background, #000000);"
	>
		<div class="max-w-7xl mx-auto px-4 py-16 md:py-24">
			<!-- Hero Header -->
			<header class="text-center mb-12">
				<ScrollReveal client:load>
					<div
						class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono mb-4 border shadow-lg"
						style="background-color: rgba(168, 85, 247, 0.1); border-color: rgba(168, 85, 247, 0.4); color: #c084fc;"
					>
						<span class="w-2 h-2 rounded-full bg-[#a855f7] animate-ping"></span>
						<span class="font-bold tracking-wider">// ARCANUM PROTOCOLS // GANG OF FOUR LINEAGE //</span>
					</div>
					<h1
						class="text-4xl md:text-6xl font-extrabold font-mono tracking-tight mb-4 text-white"
					>
						Grimoire of <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#22EE44] via-[#38bdf8] to-[#c084fc]">Incantations</span>
					</h1>
				</ScrollReveal>
				<ScrollReveal client:load delay={0.2}>
					<p
						class="text-lg md:text-xl max-w-3xl mx-auto leading-relaxed"
						style="color: var(--token-color-text-muted, #94a3b8);"
					>
						Where POSIX shell philosophy, multi-language systems code (Bash, Python, Rust, Perl, JavaScript),
						and generative latent space converge. Battle-tested scripts and frontier AI prompt patterns, traced back to the sacred 1994 Gang of Four design patterns with an arcane magical slant.
					</p>
				</ScrollReveal>

				<!-- Telemetry HUD Counter -->
				<ScrollReveal client:load delay={0.25}>
					<div class="flex flex-wrap justify-center items-center gap-3 sm:gap-4 mt-6 font-mono text-xs text-gray-400">
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#22EE44]"></span>
							<span>TOTAL SPELLS: <strong class="text-white">{allIncantations.length}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
							<span>SHELL PIPELINES: <strong class="text-white">{shellCount + scriptCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#eab308]"></span>
							<span>POLYGLOT CODE: <strong class="text-white">{pythonCount + rustCount + perlCount + jsCount + cppCount + goCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#c084fc]"></span>
							<span>AI PROMPT PATTERNS: <strong class="text-white">{promptCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span>PRIMORDIAL CODEX: <strong class="text-white">{prologCount + aplCount + fortranCount + cobolCount + javaCount + wasmCount + juliaCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#fde047]"></span>
							<span>ESOTERIC RUNES: <strong class="text-white">{lispCount + haskellCount + rubyCount + asmCount + elixirCount + solCount + zigCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#f97316]"></span>
							<span>DOMAIN & CHAOS: <strong class="text-white">{sqlCount + luaCount + rCount + phpCount + forthCount + smalltalkCount + adaCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#ef4444]"></span>
							<span>ABYSSAL & HARDWARE: <strong class="text-white">{vhdlCount + brainfuckCount + erlangCount}</strong></span>
						</div>
						<div class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#ec4899]"></span>
							<span>ARCANUM TRADITIONS: <strong class="text-white">{schoolsCount} SCHOOLS</strong></span>
						</div>
					</div>
				</ScrollReveal>

				<!-- Cyberpunk Search Bar -->
				<ScrollReveal client:load delay={0.3}>
					<div class="relative max-w-2xl mx-auto mt-8">
						<div class="relative flex items-center rounded-xl border border-white/10 bg-black/80 px-4 py-2.5 shadow-2xl focus-within:border-[#a855f7] focus-within:ring-1 focus-within:ring-[#a855f7] transition-all">
							<span class="font-mono text-xs sm:text-sm text-[#a855f7] select-none mr-2 font-bold shrink-0">
								mage@tekromancy:~$
							</span>
							<input
								id="incantation-search-input"
								type="text"
								placeholder="grep -i factory, python, rust, perl, bash, adapter, gof..."
								class="w-full bg-transparent font-mono text-xs sm:text-sm text-white placeholder-gray-500 focus:outline-none"
								aria-label="Search Incantations"
							/>
							<button
								id="search-clear-btn"
								class="hidden font-mono text-xs text-gray-400 hover:text-white px-2 py-0.5 rounded ml-2"
								title="Clear search"
							>
								ESC
							</button>
							<span class="hidden sm:inline-block font-mono text-[10px] text-gray-500 bg-white/5 border border-white/10 px-1.5 py-0.5 rounded select-none shrink-0 ml-2">
								/
							</span>
						</div>
					</div>
				</ScrollReveal>

				<!-- Category & Lineage Filter Pills -->
				<ScrollReveal client:load delay={0.35}>
					<!-- SEO Links to Hub Pages -->
					<div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-xs font-mono">
						<span class="text-gray-500 font-bold tracking-widest uppercase">Directories:</span>
						<a href="/category/creational" class="px-3 py-1.5 rounded-lg border border-[#38bdf8]/30 bg-[#38bdf8]/10 text-[#38bdf8] hover:bg-[#38bdf8]/20 transition-colors">✧ Creational</a>
						<a href="/category/structural" class="px-3 py-1.5 rounded-lg border border-[#22EE44]/30 bg-[#22EE44]/10 text-[#22EE44] hover:bg-[#22EE44]/20 transition-colors">✧ Structural</a>
						<a href="/category/behavioral" class="px-3 py-1.5 rounded-lg border border-[#a855f7]/30 bg-[#a855f7]/10 text-[#a855f7] hover:bg-[#a855f7]/20 transition-colors">✧ Behavioral</a>
						<a href="/category/architectural" class="px-3 py-1.5 rounded-lg border border-[#fbbf24]/30 bg-[#fbbf24]/10 text-[#fbbf24] hover:bg-[#fbbf24]/20 transition-colors">✧ Architectural</a>
						<a href="/category/resilience" class="px-3 py-1.5 rounded-lg border border-[#f43f5e]/30 bg-[#f43f5e]/10 text-[#f43f5e] hover:bg-[#f43f5e]/20 transition-colors">✧ Resilience</a>
						<a href="/category" class="px-3 py-1.5 rounded-lg border border-white/20 bg-white/5 text-gray-300 hover:text-white hover:border-white/40 transition-colors">All Categories →</a>
						<a href="/language" class="px-3 py-1.5 rounded-lg border border-white/20 bg-white/5 text-gray-300 hover:text-white hover:border-white/40 transition-colors">All Languages →</a>
					</div>

					<div
						class="flex flex-wrap justify-center gap-2 mt-6 text-xs font-mono"
						id="category-filters"
					>
						<button
							data-filter="all"
							class="inc-filter-btn active px-3 py-1 rounded-lg border transition-all cursor-pointer font-bold"
							style="background-color: #a855f7; color: #ffffff; border-color: #a855f7;"
						>
							All ({allIncantations.length})
						</button>
						<button
							data-filter="shell"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#38bdf8]/50 hover:text-white"
						>
							⚡ Shell One-Liners ({shellCount})
						</button>
						<button
							data-filter="script"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#22EE44]/50 hover:text-white"
						>
							📜 Bash Scripts ({scriptCount})
						</button>
						<button
							data-filter="prompt"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#c084fc]/50 hover:text-white"
						>
							🧠 AI Prompts ({promptCount})
						</button>
						<button
							data-filter="python"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#eab308]/50 hover:text-white"
						>
							🐍 Python ({pythonCount})
						</button>
						<button
							data-filter="rust"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#f97316]/50 hover:text-white"
						>
							🦀 Rust ({rustCount})
						</button>
						<button
							data-filter="perl"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#818cf8]/50 hover:text-white"
						>
							🐪 Perl ({perlCount})
						</button>
						<button
							data-filter="javascript"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#fde047]/50 hover:text-white"
						>
							🟨 JavaScript ({jsCount})
						</button>
						<button
							data-filter="cpp"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#f43f5e]/50 hover:text-white"
						>
							⚙️ C++ ({cppCount})
						</button>
						<button
							data-filter="go"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#06b6d4]/50 hover:text-white"
						>
							🐹 Go ({goCount})
						</button>
						<button
							data-filter="lisp"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#8b5cf6]/50 hover:text-white"
						>
							((🔮)) Lisp ({lispCount})
						</button>
						<button
							data-filter="haskell"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#67e8f9]/50 hover:text-white"
						>
							λ Haskell ({haskellCount})
						</button>
						<button
							data-filter="ruby"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#ef4444]/50 hover:text-white"
						>
							♦️ Ruby ({rubyCount})
						</button>
						<button
							data-filter="assembly"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#94a3b8]/50 hover:text-white"
						>
							⚙️ Assembly ({asmCount})
						</button>
						<button
							data-filter="elixir"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#60a5fa]/50 hover:text-white"
						>
							💧 Elixir ({elixirCount})
						</button>
						<button
							data-filter="solidity"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#64748b]/50 hover:text-white"
						>
							⛓️ Solidity ({solCount})
						</button>
						<button
							data-filter="zig"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#fde047]/50 hover:text-white"
						>
							⚡ Zig ({zigCount})
						</button>
						<span class="hidden md:inline-block w-px h-6 bg-white/10 self-center mx-1"></span>
						<button
							data-filter="Creational"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#22EE44]/50 hover:text-white"
						>
							GoF: Creational
						</button>
						<button
							data-filter="Structural"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#38bdf8]/50 hover:text-white"
						>
							GoF: Structural
						</button>
						<button
							data-filter="Behavioral"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#fbbf24]/50 hover:text-white"
						>
							GoF: Behavioral
						</button>
						<button
							data-filter="Resilience"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#ec4899]/50 hover:text-white"
						>
							🛡️ Resilience
						</button>
						<button
							data-filter="Architectural"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#10b981]/50 hover:text-white"
						>
							🏛️ Architectural
						</button>
						<button
							data-filter="c"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#555555]/50 hover:text-white"
						>
							C ({cCount})
						</button>
						<button
							data-filter="powershell"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#012456]/50 hover:text-white"
						>
							POWERSHELL ({powershellCount})
						</button>
						<button
							data-filter="vba"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#861D54]/50 hover:text-white"
						>
							VBA ({vbaCount})
						</button>
						<button
							data-filter="hack"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#875A7B]/50 hover:text-white"
						>
							HACK ({hackCount})
						</button>
						<button
							data-filter="raku"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#0000FB]/50 hover:text-white"
						>
							RAKU ({rakuCount})
						</button>
						<button
							data-filter="miranda"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#005500]/50 hover:text-white"
						>
							MIRANDA ({mirandaCount})
						</button>
						<button
							data-filter="purescript"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#1D222D]/50 hover:text-white"
						>
							PURESCRIPT ({purescriptCount})
						</button>
						<button
							data-filter="twine"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#005E5E]/50 hover:text-white"
						>
							TWINE ({twineCount})
						</button>
						<button
							data-filter="lean"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#555555]/50 hover:text-white"
						>
							LEAN ({leanCount})
						</button>
						<button
							data-filter="isabelle"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#336699]/50 hover:text-white"
						>
							ISABELLE ({isabelleCount})
						</button>
						<button
							data-filter="alloy"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#B0B0B0]/50 hover:text-white"
						>
							ALLOY ({alloyCount})
						</button>
						<button
							data-filter="cairo"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#FF4C29]/50 hover:text-white"
						>
							CAIRO ({cairoCount})
						</button>
						<button
							data-filter="motoko"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#0088CC]/50 hover:text-white"
						>
							MOTOKO ({motokoCount})
						</button>
						<button
							data-filter="plutus"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#0033AD]/50 hover:text-white"
						>
							PLUTUS ({plutusCount})
						</button>
						<button
							data-filter="michelson"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#2B2B2B]/50 hover:text-white"
						>
							MICHELSON ({michelsonCount})
						</button>
						<button
							data-filter="inform7"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#A52A2A]/50 hover:text-white"
						>
							INFORM7 ({inform7Count})
						</button>
						<button
							data-filter="dhall"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#A0A0A0]/50 hover:text-white"
						>
							DHALL ({dhallCount})
						</button>
						<button
							data-filter="cue"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#5886E1]/50 hover:text-white"
						>
							CUE ({cueCount})
						</button>
						<button
							data-filter="starlark"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#4B8BBE]/50 hover:text-white"
						>
							STARLARK ({starlarkCount})
						</button>
						<button
							data-filter="jsonnet"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#006400]/50 hover:text-white"
						>
							JSONNET ({jsonnetCount})
						</button>
						<button
							data-filter="chef"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#F38C00]/50 hover:text-white"
						>
							CHEF ({chefCount})
						</button>
						<button
							data-filter="chicken"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#FFCC00]/50 hover:text-white"
						>
							CHICKEN ({chickenCount})
						</button>
						<button
							data-filter="trefunge"
							class="inc-filter-btn px-3 py-1 rounded-lg border transition-all cursor-pointer font-medium bg-white/5 border-white/10 text-gray-300 hover:border-[#7B68EE]/50 hover:text-white"
						>
							TREFUNGE ({trefungeCount})
						</button>
					</div>
				</ScrollReveal>
			</header>

			<!-- Incantations Cards Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8" id="incantations-grid">
				{initialSpells.map((spell) => (
					<IncantationCard spell={spell} />
				))}
			</div>

			<!-- Sentinel for Progressive Scroll / Infinite Loading -->
			<div id="grid-sentinel" class="py-8 w-full flex items-center justify-center">
				<button
					id="load-more-btn"
					type="button"
					class="px-6 py-2.5 rounded-xl border border-white/20 bg-white/5 text-gray-300 hover:text-white hover:border-[#a855f7] font-mono text-xs transition-all cursor-pointer"
				>
					Load More Incantations...
				</button>
			</div>

			<!-- No Results Fallback -->
			<div id="no-results" class="hidden text-center py-16 font-mono text-gray-400">
				<p class="text-lg text-white mb-2">No matching incantations found in the Grimoire.</p>
				<p class="text-xs">Try searching for <span class="text-[#22EE44]">grep</span>, <span class="text-[#38bdf8]">awk</span>, <span class="text-[#c084fc]">factory</span>, or clear the search filter.</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<script id="meta-map" type="application/json" set:html={JSON.stringify({ map: TYPE_META_MAP, defaultMeta: DEFAULT_TYPE_META })} />

<script is:inline>
	(function () {
		var allSpells = null;
		var isFetching = false;
		var currentFilter = "all";
		var currentQuery = "";
		var renderedCount = 24;
		var BATCH_SIZE = 24;
		var filteredSpells = [];

		var metaMapEl = document.getElementById("meta-map");
		var metaData = metaMapEl ? JSON.parse(metaMapEl.textContent || "{}") : {};
		var typeMetaMap = metaData.map || {};
		var defaultMeta = metaData.defaultMeta || {
			badge: "✨ ARCANUM RUNE",
			badgeClass: "bg-white/10 border-white/20 text-gray-300",
			formulaTag: "$_ EXEC",
			glow: "bg-[#a855f7]"
		};

		var grid = document.getElementById("incantations-grid");
		var searchInput = document.getElementById("incantation-search-input");
		var clearBtn = document.getElementById("search-clear-btn");
		var noResults = document.getElementById("no-results");
		var sentinel = document.getElementById("grid-sentinel");
		var loadMoreBtn = document.getElementById("load-more-btn");
		var filterBtns = document.querySelectorAll(".inc-filter-btn");

		function escapeHtml(str) {
			if (!str) return "";
			return String(str)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#039;");
		}

		function getMeta(type) {
			if (!type) return defaultMeta;
			return typeMetaMap[type.toLowerCase()] || defaultMeta;
		}

		function renderCard(s) {
			var meta = getMeta(s.y);
			var typeHref = s.y ? ("/language/" + encodeURIComponent(s.y)) : ("/category/" + encodeURIComponent((s.c || "").toLowerCase()));
			var tagsHtml = (s.g || []).slice(0, 3).map(function (tag) {
				return '<span class="text-[10px] px-2 py-0.5 rounded bg-white/5 border border-white/10 text-gray-400">#' + escapeHtml(tag) + '</span>';
			}).join(" ");

			var gofCategoryLower = (s.c || "").toLowerCase();

			return '<article class="incantation-card contain-card animate-card-fade rounded-2xl border transition-all duration-300 overflow-hidden flex flex-col p-6 sm:p-7 relative group hover:shadow-2xl hover:border-[#a855f7]/50" ' +
				'data-type="' + escapeHtml(s.y) + '" data-category="' + escapeHtml(s.c) + '" ' +
				'style="background-color: var(--token-color-surface, #070c14); border-color: rgba(255, 255, 255, 0.1);">' +
				'<div class="absolute -top-10 -right-10 w-48 h-48 opacity-10 pointer-events-none rounded-full blur-2xl transition-opacity group-hover:opacity-25 ' + meta.glow + '" aria-hidden="true"></div>' +
				'<div class="relative z-10 flex flex-wrap items-center justify-between gap-2.5 mb-4">' +
					'<div class="flex items-center gap-2">' +
						'<a href="' + typeHref + '" class="px-2.5 py-1 rounded text-xs font-mono font-bold uppercase tracking-wider border hover:opacity-80 transition-opacity ' + meta.badgeClass + '">' +
							escapeHtml(meta.badge) +
						'</a>' +
						'<span class="px-2 py-0.5 rounded text-[10px] font-mono border border-white/10 bg-white/5 text-gray-300">' +
							escapeHtml(s.df || "Adept") +
						'</span>' +
					'</div>' +
					'<div class="text-[11px] font-mono text-gray-400 flex items-center gap-1.5">' +
						'<span class="w-1.5 h-1.5 rounded-full bg-[#22EE44]"></span>' +
						'<span>' + escapeHtml(s.s || "") + '</span>' +
					'</div>' +
				'</div>' +
				'<div class="relative z-10 mb-3 flex items-center gap-2 text-xs font-mono text-[#fbbf24] bg-[#fbbf24]/10 border border-[#fbbf24]/30 px-3 py-1.5 rounded-lg">' +
					'<span class="font-bold">GoF Lineage:</span>' +
					'<a href="/category/' + encodeURIComponent(gofCategoryLower) + '" class="text-white hover:text-[#fbbf24] hover:underline truncate transition-colors">' +
						escapeHtml(s.p || "") +
					'</a>' +
				'</div>' +
				'<h2 class="relative z-10 text-xl sm:text-2xl font-bold font-mono text-white mb-2 group-hover:text-[#a855f7] transition-colors">' +
					'<a href="/' + encodeURIComponent(s.id) + '" class="hover:underline">' + escapeHtml(s.t || "") + '</a>' +
				'</h2>' +
				'<p class="relative z-10 text-sm leading-relaxed text-gray-300 mb-5 flex-1">' +
					escapeHtml(s.d || "") +
				'</p>' +
				'<div class="relative z-10 mb-5 rounded-xl border border-white/10 bg-black/90 p-3.5 font-mono text-xs overflow-hidden group/box shadow-inner">' +
					'<div class="flex items-center justify-between pb-2 mb-2 border-b border-white/10 text-[10px] text-gray-400">' +
						'<span class="text-[#22EE44] font-bold">' + escapeHtml(meta.formulaTag) + '</span>' +
						'<button type="button" class="copy-formula-btn px-2 py-0.5 rounded bg-white/10 hover:bg-[#a855f7] hover:text-white text-gray-300 transition-all font-mono text-[10px] cursor-pointer flex items-center gap-1" data-formula="' + escapeHtml(s.f || "") + '" title="Copy spell to clipboard">' +
							'<span class="btn-text">Copy Incantation</span>' +
						'</button>' +
					'</div>' +
					'<pre class="overflow-x-auto text-gray-200 select-all whitespace-pre-wrap break-all text-[11px] leading-relaxed max-h-36 scrollbar-thin"><code>' + escapeHtml(s.f || "") + '</code></pre>' +
				'</div>' +
				'<div class="relative z-10 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono">' +
					'<div class="flex flex-wrap gap-1.5">' + tagsHtml + '</div>' +
					'<a href="/' + encodeURIComponent(s.id) + '" class="text-[#38bdf8] group-hover:text-[#a855f7] font-bold flex items-center gap-1 hover:underline transition-colors shrink-0 ml-2">' +
						'<span>Read Full Scroll</span><span>→</span>' +
					'</a>' +
				'</div>' +
			'</article>';
		}

		function fetchAllSpells(callback) {
			if (allSpells) {
				if (callback) callback();
				return;
			}
			if (isFetching) return;
			isFetching = true;
			fetch("/incantations.json")
				.then(function (res) { return res.json(); })
				.then(function (data) {
					allSpells = data;
					isFetching = false;
					if (callback) callback();
				})
				.catch(function (err) {
					console.error("Failed to load incantations index:", err);
					isFetching = false;
				});
		}

		function doFilter() {
			if (!allSpells) {
				fetchAllSpells(doFilter);
				return;
			}
			var q = currentQuery.toLowerCase().trim();
			var f = currentFilter.toLowerCase();

			filteredSpells = allSpells.filter(function (s) {
				var matchFilter = f === "all" ||
					(s.y && s.y.toLowerCase() === f) ||
					(s.c && s.c.toLowerCase() === f);
				if (!matchFilter) return false;
				if (!q) return true;

				return (
					(s.t && s.t.toLowerCase().indexOf(q) !== -1) ||
					(s.d && s.d.toLowerCase().indexOf(q) !== -1) ||
					(s.p && s.p.toLowerCase().indexOf(q) !== -1) ||
					(s.f && s.f.toLowerCase().indexOf(q) !== -1) ||
					(s.g && s.g.some(function (tag) { return tag.toLowerCase().indexOf(q) !== -1; })) ||
					(s.y && s.y.toLowerCase().indexOf(q) !== -1)
				);
			});

			renderedCount = Math.min(BATCH_SIZE, filteredSpells.length);
			renderBatch(false);
		}

		function renderBatch(append) {
			if (!grid) return;
			if (!append) {
				if (filteredSpells.length === 0) {
					grid.innerHTML = "";
					if (noResults) noResults.classList.remove("hidden");
					if (loadMoreBtn) loadMoreBtn.classList.add("hidden");
					return;
				}
				if (noResults) noResults.classList.add("hidden");
				var batch = filteredSpells.slice(0, renderedCount);
				grid.innerHTML = batch.map(renderCard).join("");
			} else {
				var nextBatch = filteredSpells.slice(renderedCount, renderedCount + BATCH_SIZE);
				if (nextBatch.length > 0) {
					var temp = document.createElement("div");
					temp.innerHTML = nextBatch.map(renderCard).join("");
					while (temp.firstChild) {
						grid.appendChild(temp.firstChild);
					}
					renderedCount += nextBatch.length;
				}
			}

			if (loadMoreBtn) {
				if (renderedCount < filteredSpells.length) {
					loadMoreBtn.classList.remove("hidden");
					loadMoreBtn.textContent = "Load More Spells (" + (filteredSpells.length - renderedCount) + " remaining)";
				} else {
					loadMoreBtn.classList.add("hidden");
				}
			}
		}

		function loadMore() {
			if (!allSpells) {
				fetchAllSpells(function () {
					doFilter();
				});
				return;
			}
			if (renderedCount < filteredSpells.length) {
				renderBatch(true);
			}
		}

		// Intersection Observer for continuous scrolling
		if ("IntersectionObserver" in window && sentinel) {
			var observer = new IntersectionObserver(function (entries) {
				if (entries[0].isIntersecting) {
					loadMore();
				}
			}, { rootMargin: "600px" });
			observer.observe(sentinel);
		}

		if (loadMoreBtn) {
			loadMoreBtn.onclick = loadMore;
		}

		// Event delegation for copy buttons on the grid container
		if (grid) {
			grid.addEventListener("click", function (e) {
				var btn = e.target.closest(".copy-formula-btn");
				if (!btn) return;
				e.preventDefault();
				e.stopPropagation();
				var formula = btn.getAttribute("data-formula") || "";
				var textEl = btn.querySelector(".btn-text");
				if (navigator.clipboard && formula) {
					navigator.clipboard.writeText(formula).then(function () {
						if (textEl) textEl.textContent = "COPIED! ✓";
						btn.style.backgroundColor = "#22EE44";
						btn.style.color = "#000000";
						setTimeout(function () {
							if (textEl) textEl.textContent = "Copy Incantation";
							btn.style.backgroundColor = "";
							btn.style.color = "";
						}, 2000);
					});
				}
			});
		}

		// Search and filter controls
		if (searchInput) {
			searchInput.addEventListener("focus", function () { fetchAllSpells(); });
			searchInput.addEventListener("input", function (e) {
				currentQuery = e.target.value;
				if (clearBtn) {
					if (currentQuery) clearBtn.classList.remove("hidden");
					else clearBtn.classList.add("hidden");
				}
				doFilter();
			});
		}

		if (clearBtn) {
			clearBtn.onclick = function () {
				if (searchInput) searchInput.value = "";
				currentQuery = "";
				clearBtn.classList.add("hidden");
				doFilter();
			};
		}

		filterBtns.forEach(function (btn) {
			btn.addEventListener("click", function () {
				var filter = btn.getAttribute("data-filter") || "all";
				currentFilter = filter;
				filterBtns.forEach(function (b) {
					if (b === btn) {
						b.style.backgroundColor = "#a855f7";
						b.style.color = "#ffffff";
						b.style.borderColor = "#a855f7";
					} else {
						b.style.backgroundColor = "rgba(255, 255, 255, 0.05)";
						b.style.color = "#d1d5db";
						b.style.borderColor = "rgba(255, 255, 255, 0.1)";
					}
				});
				doFilter();
			});
		});

		// Keyboard shortcuts
		window.addEventListener("keydown", function (e) {
			if ((e.key === "/" && document.activeElement !== searchInput) || (e.ctrlKey && e.key === "k") || (e.metaKey && e.key === "k")) {
				e.preventDefault();
				searchInput && searchInput.focus();
			} else if (e.key === "Escape" && document.activeElement === searchInput) {
				searchInput.value = "";
				currentQuery = "";
				clearBtn && clearBtn.classList.add("hidden");
				doFilter();
				searchInput.blur();
			}
		});

		// Prefetch index during idle time for instant search readiness
		if ("requestIdleCallback" in window) {
			window.requestIdleCallback(function () { fetchAllSpells(); });
		} else {
			setTimeout(function () { fetchAllSpells(); }, 1000);
		}
	})();
</script>
