---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { getCollection } from "astro:content";
import { SITE } from "../../config/site.mjs";

const allIncantations = await getCollection("incantations", ({ data }) => !data.draft);

// Count spells per language
const languageCounts: Record<string, number> = {};
for (const spell of allIncantations) {
	const t = spell.data.type;
	if (t) {
		languageCounts[t] = (languageCounts[t] || 0) + 1;
	}
}

const languages = Object.entries(languageCounts)
	.map(([name, count]) => ({
		name,
		count,
	}))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const pageTitle = "Programming Languages & Dialects | Tekromancy Incantations";
const pageDesc = `Browse Gang of Four design patterns and architectural code runes across ${languages.length} programming languages, esoteric dialects, and formal verification frameworks.`;
const pageUrl = `${SITE.url}/language`;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
				{ "@type": "ListItem", position: 2, name: "Languages", item: pageUrl },
			],
		},
		{
			"@type": "CollectionPage",
			name: pageTitle,
			description: pageDesc,
			url: pageUrl,
			hasPart: languages.slice(0, 50).map((l) => ({
				"@type": "WebPage",
				name: `${l.name.toUpperCase()} Incantations`,
				url: `${SITE.url}/language/${l.name}`,
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDesc}
	canonicalURL={pageUrl}
	jsonLd={jsonLd}
>
	<Header />
	<main class="min-h-screen bg-[#050505] text-white pt-24 pb-20 relative overflow-hidden">
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/15 via-[#050505] to-[#050505] pointer-events-none"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
			<!-- Semantic Breadcrumbs -->
			<nav aria-label="Breadcrumb" class="mb-8 font-mono text-xs">
				<ol class="inline-flex items-center gap-1.5 flex-wrap text-gray-400">
					<li>
						<a href="/" class="hover:text-[#22EE44] transition-colors">Home</a>
					</li>
					<li class="opacity-40">/</li>
					<li class="font-bold text-white uppercase">Languages</li>
				</ol>
			</nav>

			<!-- Header -->
			<header class="mb-14 text-center md:text-left border-b border-white/10 pb-8">
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono mb-4 border border-[#a855f7]/30 bg-[#a855f7]/10 text-[#c084fc]">
					<span>// THE POLYGLOT MATRIX //</span>
				</div>
				<h1 class="text-4xl md:text-6xl font-black font-mono tracking-tight text-white mb-4">
					Language Compendium
				</h1>
				<p class="text-lg text-gray-400 max-w-3xl font-mono leading-relaxed">
					Design patterns, idiomatic algorithms, and software incantations implemented across <span class="text-white font-bold">{languages.length}</span> programming languages, primordial mainframes, smart contract VMs, and esoteric runtimes.
				</p>
			</header>

			<!-- Language Grid -->
			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
				{languages.map((lang, i) => (
					<ScrollReveal client:load delay={(i % 24) * 0.02}>
						<a
							href={`/language/${lang.name}`}
							class="group relative flex flex-col justify-between rounded-xl border border-white/10 bg-[#0a0a0a]/80 backdrop-blur p-4 transition-all duration-200 hover:border-[#a855f7]/50 hover:bg-[#a855f7]/10 hover:shadow-lg hover:-translate-y-0.5 block h-full"
						>
							<div class="flex items-center justify-between mb-2">
								<span class="text-xs font-mono font-bold uppercase tracking-wider text-[#c084fc] group-hover:text-white transition-colors">
									{lang.name}
								</span>
								<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-gray-400 border border-white/10">
									{lang.count}
								</span>
							</div>
							<div class="text-[11px] font-mono text-gray-500 group-hover:text-gray-300 flex items-center justify-between mt-auto pt-2 border-t border-white/5">
								<span>Runes</span>
								<span>→</span>
							</div>
						</a>
					</ScrollReveal>
				))}
			</div>

			<!-- Back Link -->
			<div class="mt-14 text-center">
				<a
					href="/"
					class="inline-flex items-center gap-2 font-mono text-sm px-6 py-3 rounded-lg border border-white/20 hover:border-[#22EE44] hover:text-[#22EE44] text-white transition-all bg-white/5"
				>
					<span>← Return to Grimoire Matrix</span>
				</a>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
